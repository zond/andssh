<?xml version="1.0" encoding="utf-8"?>
<!--
  Resources referenced only by name from Dart (flutter_local_notifications
  looks the notification icon up at runtime) are invisible to the R8
  resource shrinker and get stripped from release builds. Keep them here.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_notification" />
